# ====================================================================
# Cultiva — Environment Variables Template (.env.example)
# IMPORTANT: Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file or API keys to GitHub!
# ====================================================================

# [Required for Cultiva IA features]: Google Gemini API Key
# Obtain for free at: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# [Optional / Hosting]: Port number (Render, Railway, Fly.io inject this automatically)
PORT=3000

# [Optional / Hosting]: Environment mode ('development' | 'production')
NODE_ENV=development

# [Optional / Cultiva 3.0 Cloud Sync]: Supabase Cloud URL & Public Anon Key
# Obtain at: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL_HERE
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

